[Unit]
Description=DREAMMACHINE Show Watchdog (auto-recover REAPER from a hung X/lightdm session)
After=graphical.target lightdm.service

[Service]
Type=simple
User=root
ExecStart=/bin/bash /home/sjc/dreammachine/provisioning/show_watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
