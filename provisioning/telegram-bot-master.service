[Unit]
Description=DREAMMACHINE Telegram fleet command bot (master, runs only on sjcdm4)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=sjc
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/sjc/telegram_bot_master.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
