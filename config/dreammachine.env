# Single source of configuration for the DREAMMACHINE Pi units.
# Sourced by setup scripts and read by led/led_controller.py (via python-dotenv).
# Copy/adjust per-unit if a future Pi needs different pins (name the file
# dreammachine.<hostname>.env and update the systemd unit's EnvironmentFile=).

# --- LED strip ---
# GPIO 18/19/20/21 are reserved by the Audio+ V3 shield (I2S) - never reuse them.
# GPIO 0/1 are reserved by the shield's ID EEPROM.
LED_PINS=12,13,16,17,22,27
LED_MIN_BRIGHTNESS=10
LED_MAX_BRIGHTNESS=100
LED_PWM_FREQ_HZ=200

# --- OSC (REAPER <-> LED sync) ---
# REAPER control surface "OSC (ReaOSC)" should be configured to send to
# OSC_LISTEN_HOST:OSC_LISTEN_PORT (this Python script listens here).
OSC_LISTEN_HOST=127.0.0.1
OSC_LISTEN_PORT=9000
# Optional: port REAPER listens on if the LED script needs to send anything back.
OSC_REAPER_PORT=9001

# --- REAPER project ---
REAPER_PROJECT_NAME=Dreammachine_popo_01
REAPER_PROJECT_DIR=/home/sjc/reaper-projects
REAPER_PROJECT_PATH=${REAPER_PROJECT_DIR}/${REAPER_PROJECT_NAME}/${REAPER_PROJECT_NAME}.RPP

# --- Audio ---
ALSA_CARD_NAME=sndrpihifiberry
